{
  "config": {
    "title": "Fieldwork CRM",
    "objects": [
      {"id": "companies", "label": "Companies", "fields": [
        {"id": "name", "label": "Company", "type": "text", "required": true, "unique": true},
        {"id": "industry", "label": "Industry", "type": "text"},
        {"id": "contact", "label": "Contact", "type": "text"}
      ]},
      {"id": "sales", "label": "Sales", "fields": [
        {"id": "name", "label": "Sale", "type": "text", "required": true},
        {"id": "amount", "label": "Amount (USD)", "type": "number", "required": true},
        {"id": "date", "label": "Date", "type": "date", "required": true},
        {"id": "status", "label": "Status", "type": "select", "required": true, "options": ["Paid", "Pending"]}
      ]},
      {"id": "opportunities", "label": "Opportunities", "fields": [
        {"id": "name", "label": "Opportunity", "type": "text", "required": true},
        {"id": "amount", "label": "Value (USD)", "type": "number", "required": true},
        {"id": "stage", "label": "Stage", "type": "select", "required": true, "options": ["Discovery", "Proposal", "Negotiation", "Won", "Lost"]},
        {"id": "close_date", "label": "Expected close", "type": "date"}
      ]}
    ],
    "relations": [
      {"id": "company_sales", "label": "Company sales", "from": "companies", "to": "sales", "cardinality": "one-to-many"},
      {"id": "company_opportunities", "label": "Company opportunities", "from": "companies", "to": "opportunities", "cardinality": "many-to-many"}
    ],
    "queries": [
      {"id": "recent_sales", "object": "sales", "fields": ["name", "amount", "date", "status"], "filters": [{"field": "date", "op": "last_days", "value": 30}], "sort": "date", "descending": true, "aggregate": "rows"},
      {"id": "sales_total", "object": "sales", "fields": ["amount"], "filters": [{"field": "date", "op": "last_days", "value": 30}], "aggregate": "sum", "measure": "amount"},
      {"id": "pipeline_total", "object": "opportunities", "fields": ["amount"], "filters": [{"field": "stage", "op": "ne", "value": "Won"}, {"field": "stage", "op": "ne", "value": "Lost"}], "aggregate": "sum", "measure": "amount"},
      {"id": "opportunity_count", "object": "opportunities", "fields": ["name"], "filters": [{"field": "stage", "op": "ne", "value": "Won"}, {"field": "stage", "op": "ne", "value": "Lost"}], "aggregate": "count"},
      {"id": "company_count", "object": "companies", "fields": ["name"], "filters": [], "aggregate": "count"},
      {"id": "open_opportunities", "object": "opportunities", "fields": ["name", "amount", "stage", "close_date"], "filters": [{"field": "stage", "op": "ne", "value": "Won"}, {"field": "stage", "op": "ne", "value": "Lost"}], "sort": "amount", "descending": true, "aggregate": "rows"},
      {"id": "pipeline_stages", "object": "opportunities", "fields": ["stage", "amount"], "filters": [{"field": "stage", "op": "ne", "value": "Won"}, {"field": "stage", "op": "ne", "value": "Lost"}], "aggregate": "sum", "measure": "amount", "groupBy": "stage"}
    ],
    "screens": [{"id": "overview", "title": "Sales overview", "widgets": [
      {"type": "metric", "title": "Sales · last 30 days (USD)", "query": "sales_total", "width": 3},
      {"type": "metric", "title": "Open pipeline (USD)", "query": "pipeline_total", "width": 3},
      {"type": "metric", "title": "Open opportunities", "query": "opportunity_count", "width": 3},
      {"type": "metric", "title": "Companies in your network", "query": "company_count", "width": 3},
      {"type": "table", "title": "Recent sales", "query": "recent_sales", "width": 8},
      {"type": "bar", "title": "Pipeline by stage (USD)", "query": "pipeline_stages", "width": 4},
      {"type": "table", "title": "Open opportunities", "query": "open_opportunities", "width": 12}
    ]}]
  },
